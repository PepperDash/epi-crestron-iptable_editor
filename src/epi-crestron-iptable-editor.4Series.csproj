<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ProjectType>ProgramLibrary</ProjectType>
	</PropertyGroup>
	<PropertyGroup>
		<TargetFramework>net8</TargetFramework>
		<RootNamespace>PepperDash.Essentials.Plugins.Crestron.IpTable_Editor</RootNamespace>
		<AssemblyName>PepperDash.Essentials.Plugins.Crestron.IpTable_Editor</AssemblyName>
		<Deterministic>false</Deterministic>
		<AssemblyTitle>PepperDash.Essentials.Plugins.Crestron.IpTable_Editor</AssemblyTitle>
		<Company>PepperDash Technology</Company>
		<Description>This software is a plugin for PepperDash Essentials.</Description>
		<Copyright>Copyright 2025</Copyright>
		<Version>1.0.0-local</Version>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<InformationalVersion>$(Version)</InformationalVersion>
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<Authors>PepperDash Technology</Authors>
		<PackageId>PepperDash.Essentials.Plugins.Crestron.IpTable_Editor</PackageId>
		<PackageProjectUrl>https://github.com/PepperDash/epi-crestron-iptable_editor.git</PackageProjectUrl>
		<PackageTags>crestron 4series essentials iptable editor</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Properties\**" />
		<EmbeddedResource Remove="Properties\**" />
		<None Remove="Properties\**" />
	</ItemGroup>

	<ItemGroup>
    <None Remove="epi-make-model.projectinfo" />
  </ItemGroup>

  <ItemGroup>
 	<PackageReference Include="PepperDashEssentials" Version="3.0.0-dev-v3-routing.63" >
  		<ExcludeAssets>runtime</ExcludeAssets>
 	</PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="../output\epi-crestron-iptable-editor.4Series.1.0.0-local.cplz" />
  </ItemGroup>
</Project>
